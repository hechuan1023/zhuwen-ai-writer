[Unit]
Description=Zhuwen LongCat isolated gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zhuwen-longcat
EnvironmentFile=/etc/zhuwen-longcat.env
ExecStart=/usr/bin/python3 /opt/zhuwen-longcat/zhuwen-gateway.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
